---
import Pic from './Pic.astro';
type Props = { items: { name: string; file: string; href?: string }[]; label?: string; height?: number; folder?: string };
const { items, label, height = 56, folder = '' } = Astro.props;
---
<div class="marquee" data-marquee role="group" aria-label={label ?? 'Logos'}>
  <div class="track">
    {[0, 1].map((n) => (
      <ul aria-hidden={n === 1 ? 'true' : undefined}>
        {items.map((it) => (
          <li>
            {it.href && n === 0 ? (
              <a href={it.href} target="_blank" rel="noopener noreferrer" aria-label={it.name}>
                <Pic src={`${folder}${it.file}`} alt={it.name} width={200} sizes="160px" />
              </a>
            ) : (
              <span><Pic src={`${folder}${it.file}`} alt={n === 0 ? it.name : ''} width={200} sizes="160px" /></span>
            )}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
<style define:vars={{ h: `${height}px` }}>
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; animation: scroll 55s linear infinite; }
  .marquee.paused .track, .marquee:hover .track { animation-play-state: paused; }
  ul { display: flex; align-items: center; gap: clamp(36px, 5vw, 72px); padding-right: clamp(36px, 5vw, 72px); }
  li { flex: none; }
  li :global(img) { height: var(--h); width: auto; max-width: 190px; object-fit: contain; filter: grayscale(1); opacity: .62; transition: filter .35s, opacity .35s, transform .35s var(--ease-out); }
  li:hover :global(img) { filter: none; opacity: 1; transform: scale(1.06); }
  a, span { display: block; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; } ul[aria-hidden] { display: none; } .marquee { mask-image: none; -webkit-mask-image: none; } ul { flex-wrap: wrap; justify-content: center; padding: 0; } }
</style>
