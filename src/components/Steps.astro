---
type Props = { steps: { title: string; body: string }[]; cols?: number };
const { steps, cols = 4 } = Astro.props;
---
<ol class="steps" data-steps style={`--cols:${cols}`}>
  <div class="line-bg" aria-hidden="true"><i data-line></i></div>
  {steps.map((s, i) => (
    <li data-step-card>
      <span class="node" data-node>{i + 1}</span>
      <h3>{s.title.replace(/^\d+\.\s*/, '')}</h3>
      <p>{s.body}</p>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; position: relative; display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: clamp(20px, 3vw, 40px); counter-reset: s; }
  .line-bg { position: absolute; left: 24px; right: 24px; top: 24px; height: 2px; background: var(--line); border-radius: 2px; }
  .line-bg i { display: block; height: 100%; background: linear-gradient(90deg, var(--c-blue), var(--c-green), var(--c-orange), var(--c-red)); transform-origin: left; }
  li { position: relative; padding-top: 72px; }
  .node { position: absolute; left: 0; top: 0; width: 48px; height: 48px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-weight: 650; font-size: 1.05rem; box-shadow: 0 0 0 6px var(--paper); }
  h3 { margin-bottom: 8px; }
  p { color: var(--ink-2); margin: 0; }
  @media (max-width: 800px) {
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .line-bg { left: 23px; right: auto; width: 2px; top: 24px; bottom: 24px; height: auto; }
    .line-bg i { width: 100%; height: 100%; transform-origin: top; }
    li { padding: 4px 0 0 72px; }
  }
</style>
