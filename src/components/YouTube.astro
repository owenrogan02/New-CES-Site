---
import Icon from './Icon.astro';
import Pic from './Pic.astro';
type Props = { id: string; title: string; poster: string; posterAlt?: string; start?: string };
const { id, title, poster, posterAlt = '', start } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${start ? `&start=${start}` : ''}`;
---
<div class="yt" data-yt={src} data-title={title}>
  <Pic src={poster} alt={posterAlt} width={1100} sizes="(max-width: 900px) 100vw, 900px" />
  <button type="button" aria-label={`Play video: ${title}`}>
    <span class="ring"></span>
    <span class="play"><Icon name="play" size={30} /></span>
    <span class="cap">Play video</span>
  </button>
</div>
<style>
  .yt { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-l); overflow: hidden; background: linear-gradient(135deg, #f6f7fb, #eaf0f8); border: 1px solid var(--line); box-shadow: var(--shadow-float); }
  .yt :global(img) { width: 100%; height: 100%; object-fit: contain; padding: 4%; }
  button { position: absolute; inset: 0; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; align-content: center; gap: 14px; }
  .play { width: 84px; height: 84px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; box-shadow: 0 20px 40px -12px oklch(20% 0.05 262 / .5); transition: transform .4s var(--ease-out); position: relative; z-index: 1; }
  .play :global(svg) { margin-left: 4px; }
  .ring { position: absolute; width: 84px; height: 84px; border-radius: 50%; border: 2px solid var(--ink); opacity: 0; animation: ping 2.4s ease-out infinite; }
  .cap { position: relative; font-weight: 550; color: var(--ink); background: #fff; padding: 6px 14px; border-radius: 999px; font-size: .9rem; box-shadow: var(--shadow-card); }
  button:hover .play { transform: scale(1.08); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; }
  .playing button, .playing :global(img) { display: none; }
  @keyframes ping { 0% { transform: scale(1); opacity: .5; } 100% { transform: scale(1.9); opacity: 0; } }
</style>
