---
import GradientBand from './GradientBand.astro';
import Pic from './Pic.astro';
type Props = { eyebrow?: string; title: string; lede?: string; image?: string; imageAlt?: string; imageWidth?: number; compact?: boolean; full?: boolean };
const { eyebrow, title, lede, image, imageAlt = '', imageWidth = 760, compact = false, full = false } = Astro.props;
---
<section class:list={['phero', { compact, hasimg: !!image, hasvis: Astro.slots.has('visual') }]} data-hero>
  <GradientBand class="pband" />
  <div class="container wide inner">
    <div class="copy">
      {eyebrow && <p class="eyebrow" data-reveal="fade">{eyebrow}</p>}
      <h1 data-split="now" data-split-delay="0.1" set:html={title} />
      {lede && <p class="lede" data-reveal>{lede}</p>}
      <div class="btns" data-reveal><slot /></div>
    </div>
    {Astro.slots.has('visual') && (
      <div class="vis custom" data-hero-visual>
        <div data-device class="dev"><slot name="visual" /></div>
      </div>
    )}
    {image && (
      <div class="vis" data-hero-visual>
        <div data-device class="dev">
          <Pic src={image} alt={imageAlt} width={imageWidth} priority sizes="(max-width: 900px) 100vw, 640px" />
        </div>
      </div>
    )}
  </div>
</section>
<style>
  .phero { position: relative; padding: calc(var(--header-h) + clamp(48px, 7vw, 96px)) 0 clamp(56px, 7vw, 100px); overflow: clip; }
  .phero.compact { padding-bottom: clamp(40px, 5vw, 70px); }
  :global(.pband) { right: -8%; top: -10%; width: 72%; height: 78%; transform: skewY(-6deg); transform-origin: 100% 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to bottom, #000 55%, transparent 100%);
    -webkit-mask-composite: source-in; mask-composite: intersect;
    mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to bottom, #000 55%, transparent 100%); opacity: .9; }
  .inner { position: relative; display: grid; gap: 48px; grid-template-columns: 1fr; align-items: center; }
  .hasimg .inner, .hasvis .inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .copy { max-width: 720px; }
  .copy h1 { font-size: clamp(2.5rem, 5.6vw, 4.5rem); line-height: 1.02; letter-spacing: -0.04em; }
  .copy :global(.serif) { letter-spacing: -0.02em; }
  .lede { margin: 24px 0 0; }
  .btns { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .btns:empty { display: none; }
  .vis { position: relative; }
  .dev > :global(img) { width: 100%; height: auto; filter: drop-shadow(0 30px 40px oklch(30% 0.08 262 / 0.25)); border-radius: 18px; }
  @media (max-width: 900px) {
    .hasimg .inner, .hasvis .inner { grid-template-columns: 1fr; }
    :global(.pband) { width: 130%; right: -30%; height: 55%; }
  }
</style>
