---
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { touchFeatures, partners } from '../config/data';
import { site } from '../config/site';

const ring = ['Sage', 'Xero', 'Wavesoft', 'Ingenico', 'Guestline Reslynx', 'Payment Sense'].map((n) => partners.find((p) => p.name === n)!);
const bars = [38, 52, 44, 68, 58, 82, 74];
const till = [
  ['Beer', 'b'], ['Spirits', 'b'], ['Wine', 'b'],
  ['Cocktails', 'p'], ['Soft Drinks', 'p'], ['Snacks', 'p'],
  ['Burgers', 'v'], ['Grill', 'v'], ['Breakfast', 'v'],
  ['Salads', 'v'], ['Sides', 'o'], ['Dessert', 'o'],
];
const peripherals = ['Scanners', 'Scales', 'Kitchen printers', 'Label printers', 'Tablets', 'Chip & PIN'];
---
<div class="story" data-story>
  <div class="steps" data-steps-col>
    <div class="rail" aria-hidden="true"><i data-rail-fill></i></div>
    {touchFeatures.map((f, i) => (
      <article class="step" data-step>
        <div class="step-in">
          <p class="num" aria-hidden="true"><span data-dot>{String(i + 1).padStart(2, '0')}</span></p>
          <Pic src={f.icon} alt="" width={64} sizes="64px" class="ico" />
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="stage-wrap" aria-hidden="true">
    <div class="stage">
      <div class="aura"></div>

      <div class="viz" data-visual>
        <div class="orbit">
          <div class="hub">CES<br />Touch</div>
          {ring.map((p, i) => (
            <div class="sat" style={`--a:${i * 60}deg`}><span><Pic src={p.file} alt="" width={150} sizes="90px" /></span></div>
          ))}
          <svg viewBox="-100 -100 200 200" class="links">
            {ring.map((_, i) => <line x1="0" y1="0" x2={Math.round(Math.cos((i * 60 - 90) * Math.PI / 180) * 78)} y2={Math.round(Math.sin((i * 60 - 90) * Math.PI / 180) * 78)} />)}
          </svg>
        </div>
      </div>

      <div class="viz" data-visual>
        <div class="floor">
          {['Table 1', 'Table 2', 'Table 3', 'Table 4', 'Table 5', 'Table 6'].map((t, i) => (
            <div class:list={['tbl', { hot: i === 3, round: i % 2 === 1 }]}>{t}</div>
          ))}
          <div class="sheet"><b>Table 4</b><span>Charge sheet</span><em>Split bill</em></div>
        </div>
      </div>

      <div class="viz" data-visual>
        <div class="chart">
          <div class="bars">{bars.map((h, i) => <i style={`--h:${h}%;--d:${i * 70}ms`}></i>)}</div>
          <svg viewBox="0 0 280 100" preserveAspectRatio="none" class="line"><polyline points="0,80 46,66 92,72 138,44 184,52 230,22 280,30" /></svg>
          <div class="kpis"><span>Reports</span><span>Inventory</span><span>Employee activity</span></div>
        </div>
      </div>

      <div class="viz" data-visual>
        <div class="screen">
          <div class="grid">{till.map(([t, c]) => <span class={`k-${c}`}>{t}</span>)}</div>
          <div class="designer"><Icon name="sparkle" size={16} /> Screen designer</div>
        </div>
      </div>

      <div class="viz" data-visual>
        <div class="chips">
          <div class="plug"><Icon name="touch" size={34} /></div>
          {peripherals.map((p, i) => <span style={`--i:${i}`}>{p}</span>)}
        </div>
      </div>

      <div class="viz" data-visual>
        <div class="help">
          <p class="big"><Icon name="phone" size={22} /> {site.phone}</p>
          <p><Icon name="mail" size={18} /> {site.supportEmail}</p>
          <p><Icon name="mail" size={18} /> {site.salesEmail}</p>
        </div>
      </div>

      <ol class="dots">{touchFeatures.map(() => <li data-dot></li>)}</ol>
    </div>
  </div>
</div>

<style>
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .steps { position: relative; padding-left: 28px; }
  .rail { position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--line); border-radius: 2px; }
  .rail i { position: absolute; inset: 0; background: var(--grad-flow); background: linear-gradient(180deg, var(--c-blue), var(--c-green), var(--c-orange), var(--c-red)); border-radius: 2px; transform-origin: top; transform: scaleY(1); }
  .step { min-height: 78vh; display: flex; align-items: center; opacity: 1; }
  .step-in { max-width: 460px; }
  .num { font-family: var(--font-mono); font-size: .8rem; color: var(--ink-3); margin: 0 0 14px; }
  .ico { width: 56px; height: 56px; margin-bottom: 18px; }
  .step h3 { font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -.03em; margin-bottom: 14px; }
  .step p:not(.num) { font-size: 1.1rem; }

  .stage-wrap { position: sticky; top: calc(var(--header-h) + 36px); height: min(620px, calc(100svh - var(--header-h) - 72px)); display: grid; }
  .stage { position: relative; border-radius: var(--radius-xl); background: linear-gradient(160deg, #fff, var(--paper-3)); border: 1px solid var(--line); box-shadow: var(--shadow-float); overflow: hidden; }
  .aura { position: absolute; inset: -20%; background: radial-gradient(35% 35% at 25% 25%, color-mix(in oklab, var(--c-blue) 22%, transparent), transparent), radial-gradient(35% 35% at 80% 30%, color-mix(in oklab, var(--c-orange) 22%, transparent), transparent), radial-gradient(40% 40% at 60% 85%, color-mix(in oklab, var(--c-red) 18%, transparent), transparent), radial-gradient(35% 35% at 15% 80%, color-mix(in oklab, var(--c-green) 20%, transparent), transparent); filter: blur(10px); }
  .viz { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transform: translateY(40px) scale(.96); transition: opacity .6s, transform .8s var(--ease-out); pointer-events: none; }
  .viz.is-active { opacity: 1; transform: none; }
  .viz.is-before { transform: translateY(-40px) scale(.96); }
  .dots { list-style: none; margin: 0; padding: 0; position: absolute; right: 18px; top: 50%; transform: translateY(-50%); display: grid; gap: 8px; }
  .dots li { width: 6px; height: 6px; border-radius: 50%; background: oklch(80% .01 262); transition: .4s; }
  .dots li.is-on { background: var(--ink); height: 18px; border-radius: 6px; }
  .num span { transition: color .3s; }
  .step.is-active .num span { color: var(--brand-ink); }

  /* 1: integration */
  .orbit { position: relative; width: min(420px, 78%); aspect-ratio: 1; }
  .hub { position: absolute; inset: 34%; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; text-align: center; font-weight: 650; letter-spacing: -.03em; line-height: 1.05; font-size: clamp(.9rem, 1.6vw, 1.2rem); box-shadow: 0 0 0 10px color-mix(in oklab, var(--ink) 8%, transparent), 0 20px 40px -12px oklch(20% .05 262 / .5); z-index: 2; }
  .sat { position: absolute; inset: 0; transform: rotate(var(--a)); }
  .sat span { position: absolute; left: 50%; top: 0; width: 22%; aspect-ratio: 1; margin-left: -11%; border-radius: 50%; background: #fff; box-shadow: var(--shadow-card); border: 1px solid var(--line); display: grid; place-items: center; transform: rotate(calc(var(--a) * -1)); padding: 14%; }
  .sat span :global(img) { position: absolute; inset: 16%; width: 68%; height: 68%; object-fit: contain; }
  .links { position: absolute; inset: 0; width: 100%; height: 100%; }
  .links line { stroke: oklch(75% .02 262); stroke-width: .8; stroke-dasharray: 3 3; }

  /* 2: bookings */
  .floor { position: relative; width: min(440px, 82%); display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .tbl { aspect-ratio: 1.15; border-radius: 16px; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-card); display: grid; place-items: center; font-weight: 550; font-size: .95rem; color: var(--ink-2); }
  .tbl.round { border-radius: 50%; }
  .tbl.hot { background: var(--ink); color: #fff; border-color: var(--ink); }
  .sheet { position: absolute; right: -4%; bottom: -16%; background: #fff; border-radius: 16px; padding: 14px 18px; box-shadow: var(--shadow-float); border: 1px solid var(--line); display: grid; gap: 2px; min-width: 170px; }
  .sheet b { color: var(--ink); } .sheet span { color: var(--ink-3); font-size: .85rem; } .sheet em { font-style: normal; color: var(--brand-ink); font-weight: 600; font-size: .9rem; }

  /* 3: analytics */
  .chart { position: relative; width: min(440px, 84%); background: #fff; border-radius: 22px; border: 1px solid var(--line); box-shadow: var(--shadow-float); padding: 26px 26px 18px; }
  .bars { display: flex; align-items: flex-end; gap: 12px; height: 190px; }
  .bars i { flex: 1; height: var(--h); border-radius: 8px 8px 3px 3px; background: linear-gradient(180deg, var(--c-blue), color-mix(in oklab, var(--c-blue) 45%, white)); transform-origin: bottom; }
  .bars i:nth-child(3n) { background: linear-gradient(180deg, var(--c-green), color-mix(in oklab, var(--c-green) 45%, white)); }
  .bars i:nth-child(5n) { background: linear-gradient(180deg, var(--c-orange), color-mix(in oklab, var(--c-orange) 45%, white)); }
  .is-active .bars i { animation: grow .9s var(--ease-out) both; animation-delay: var(--d); }
  @keyframes grow { from { transform: scaleY(0); } }
  .line { position: absolute; left: 26px; right: 26px; top: 26px; width: calc(100% - 52px); height: 190px; fill: none; }
  .line polyline { stroke: var(--c-red); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; stroke-dasharray: 600; stroke-dashoffset: 0; }
  .is-active .line polyline { animation: dash 1.4s .3s ease-out both; }
  @keyframes dash { from { stroke-dashoffset: 600; } }
  .kpis { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
  .kpis span { font-size: .78rem; font-family: var(--font-mono); padding: 5px 10px; border-radius: 999px; background: var(--paper-3); color: var(--ink-2); }

  /* 4: customisation */
  .screen { width: min(430px, 84%); background: #12172b; border-radius: 22px; padding: 14px; box-shadow: var(--shadow-float); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .grid span { display: grid; place-items: center; min-height: 56px; border-radius: 8px; color: #fff; font-weight: 600; font-size: .9rem; text-align: center; }
  .k-b { background: #1d4fd8; } .k-p { background: #7a2fc8; } .k-v { background: #8f2bb0; } .k-o { background: #e8761a; }
  .is-active .grid span { animation: pop .5s var(--ease-out) both; }
  .is-active .grid span:nth-child(2n) { animation-delay: .06s; } .is-active .grid span:nth-child(3n) { animation-delay: .12s; } .is-active .grid span:nth-child(5n) { animation-delay: .18s; }
  @keyframes pop { from { transform: scale(.8); opacity: 0; } }
  .designer { display: flex; align-items: center; gap: 8px; margin-top: 12px; color: #fff; font-size: .85rem; opacity: .85; justify-content: center; }

  /* 5: versatility */
  .chips { position: relative; width: min(420px, 80%); aspect-ratio: 1; }
  .plug { position: absolute; inset: 36%; border-radius: 28%; background: var(--brand-ink); color: #fff; display: grid; place-items: center; box-shadow: 0 20px 40px -14px var(--c-red); }
  .chips span { position: absolute; left: 50%; top: 50%; padding: 9px 16px; border-radius: 999px; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-card); font-weight: 550; color: var(--ink); font-size: .92rem; white-space: nowrap;
    --r: clamp(110px, 12vw, 160px); transform: translate(-50%, -50%) rotate(calc(var(--i) * 60deg - 90deg)) translateX(var(--r)) rotate(calc(var(--i) * -60deg + 90deg)); }

  /* 6: support */
  .help { display: grid; gap: 14px; width: min(400px, 80%); }
  .help p { margin: 0; display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 18px; padding: 18px 22px; border: 1px solid var(--line); box-shadow: var(--shadow-card); color: var(--ink); font-weight: 550; }
  .help .big { background: var(--ink); color: #fff; font-size: 1.5rem; letter-spacing: -.02em; padding: 24px; }

  @media (max-width: 899px) {
    .story { display: block; }
    .stage-wrap { display: none; }
    .steps { padding-left: 0; }
    .rail { display: none; }
    .step { min-height: 0; padding: 22px 0; border-bottom: 1px solid var(--line); }
  }
</style>
